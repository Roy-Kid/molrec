{
  "$defs": {
    "BlockModel": {
      "additionalProperties": true,
      "description": "Named columns sharing one count, plus an optional structural shape.\n\nA plain table has implicit shape ``[count]``. A volumetric block declares\n``structural_shape = (nx, ny, nz)`` with ``nx * ny * nz == count`` -- the\nonly thing that makes a flat column reshapable after a roundtrip.\n\nA block imposes no meaning on its column names.",
      "properties": {
        "columns": {
          "additionalProperties": {
            "$ref": "#/$defs/ColumnModel"
          },
          "title": "Columns",
          "type": "object"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "structural_shape": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Shape"
        }
      },
      "required": [
        "count"
      ],
      "title": "BlockModel",
      "type": "object"
    },
    "BoxModel": {
      "description": "The triclinic cell. Columns of ``vectors`` are the lattice vectors.\n\nA box belongs to a frame, so fixed-cell and variable-cell runs are both\nnatural -- each frame in a trajectory carries its own.",
      "properties": {
        "boundary": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "origin": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "vectors": {
          "items": {},
          "title": "Vectors",
          "type": "array"
        }
      },
      "required": [
        "vectors"
      ],
      "title": "BoxModel",
      "type": "object"
    },
    "ColumnModel": {
      "description": "A typed N-dimensional array.\n\nThe leading axis length is the owning block's count; trailing axes are\nper-entity structure, so ``Float[count][3]`` is one column, not three.",
      "properties": {
        "dtype": {
          "enum": [
            "f16",
            "f32",
            "f64",
            "i8",
            "i16",
            "i32",
            "i64",
            "u8",
            "u16",
            "u32",
            "u64",
            "bool",
            "string",
            "c64",
            "c128"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Shape",
          "type": "array"
        },
        "values": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "required": [
        "dtype",
        "shape"
      ],
      "title": "ColumnModel",
      "type": "object"
    },
    "FrameModel": {
      "additionalProperties": true,
      "description": "A map of names to blocks, plus free-form meta and an optional box.\n\nA frame enforces no relationship between blocks: block counts are\nindependent and any block name is legal.",
      "properties": {
        "blocks": {
          "additionalProperties": {
            "$ref": "#/$defs/BlockModel"
          },
          "title": "Blocks",
          "type": "object"
        },
        "box": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoxModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        }
      },
      "title": "FrameModel",
      "type": "object"
    },
    "MetaModel": {
      "additionalProperties": true,
      "description": "The record's identity document.\n\n``extra=\"allow\"`` is not convenience -- it is the preserve-the-unknown\ninvariant: a reader must keep keys it does not recognize.",
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "format_name": {
          "anyOf": [
            {
              "const": "molrec",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Name"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "record_schema_version": {
          "minimum": 1,
          "title": "Record Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "record_schema_version"
      ],
      "title": "MetaModel",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The record root.\n\n``meta`` is always required, plus at least one substantive section. The\nother sections arrive with their own modules; this module owns ``frame``\nand ``system``.",
  "properties": {
    "frame": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrameModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "meta": {
      "$ref": "#/$defs/MetaModel"
    },
    "system": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrameModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "meta"
  ],
  "title": "RecordModel",
  "type": "object"
}
